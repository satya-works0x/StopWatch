<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MultiTimerApp.MainWindow"
        Title="MultiTimer" Width="350" Height="250" MinWidth="70" MinHeight="100"
        Topmost="True" Background="#121212">
    <DockPanel>
        
        <!-- Slim Heading Panel -->
        <Grid DockPanel.Dock="Top" Background="#2b2b2b" Height="32" ColumnDefinitions="Auto, Auto, *">
            <!-- Left Side: + Icon -->
            <Button Grid.Column="0" Content="+" Click="BtnAdd_Click" Width="35" Height="32" Background="Transparent" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" FontWeight="Bold"/>
            
            <!-- Left Side: Dropdown Menu -->
            <Menu Grid.Column="1" Height="32" Background="Transparent" Padding="0">
                <MenuItem Header="▼" FontSize="12" Padding="8,8">
                    <MenuItem Header="New Stopwatch" Click="NewStopwatch_Click"/>
                    <MenuItem Header="New Countdown" Click="NewCountdown_Click"/>
                    <Separator/>
                    <MenuItem Header="Layout: Side-by-Side (Horizontal)" Click="LayoutHorizontal_Click"/>
                    <MenuItem Header="Layout: Stacked (Portrait)" Click="LayoutPortrait_Click"/>
                </MenuItem>
            </Menu>
        </Grid>
        
        <!-- HorizontalScrollBarVisibility="Disabled" forces items to wrap or shrink when window is made tiny -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="TimersPanel" Orientation="Horizontal" Margin="5" HorizontalAlignment="Left"/>
        </ScrollViewer>
        
    </DockPanel>
</Window>