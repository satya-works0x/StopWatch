<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MultiTimerApp.TimerWidget"
             SizeChanged="OnSizeChanged"
             Margin="5">
    
    <Border x:Name="RootBorder" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Padding="10" Background="#1e1e1e">
        <!-- Kept strictly minimal so it doesn't stretch across the row -->
        <StackPanel Orientation="Vertical" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <TextBox x:Name="TbName" PlaceholderText="Topic..." FontWeight="Bold" Width="130" TextAlignment="Center"/>
            
            <StackPanel x:Name="CountdownSetupPanel" IsVisible="False" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Min:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="TbMinutes" Width="40" Text="30" FontSize="12" Padding="2"/>
            </StackPanel>

            <TextBlock x:Name="TxtDisplay" Text="00:00:00" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
            
            <StackPanel x:Name="ControlsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Content="▶" Click="BtnStart_Click" Width="32" HorizontalContentAlignment="Center" Background="#2e7d32" FontSize="14" Padding="4"/>
                <Button Content="⏸" Click="BtnStop_Click" Width="32" HorizontalContentAlignment="Center" Background="#c62828" FontSize="14" Padding="4"/>
                <Button Content="🔄" Click="BtnReset_Click" Width="32" HorizontalContentAlignment="Center" Background="#1565c0" FontSize="14" Padding="4"/>
            </StackPanel>
            
        </StackPanel>
    </Border>
</UserControl>